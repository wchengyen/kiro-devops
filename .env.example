# 飞书应用凭证（必填）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kiro CLI 超时时间（秒）
KIRO_TIMEOUT=120
# KIRO_SYNC_TIMEOUT=120
# KIRO_ASYNC_TIMEOUT=1800
# KIRO_PROGRESS_INTERVAL=300

# 指定 Kiro agent（可选，留空则使用默认 agent）
# KIRO_AGENT=my-dev-bot

# 默认聊天模型（可选，留空使用 kiro-cli 默认）
# DEFAULT_MODEL=
# 后台任务模型（Scheduler / 告警分析，可选，留空使用 kiro-cli 默认）
# BACKGROUND_MODEL=

# === 多飛書 App / 多 AWS Profile（分階段功能，預設關閉）===
# 正式切換前必須完成設定、STS 與回滾驗證
MULTI_PROFILE_ENABLED=false
# MULTI_PROFILE_CONFIG=/home/ubuntu/kiro-devops/multi_profile_config.yaml

# 每個飛書 App 的 Secret 仍只放 .env；YAML 只引用變數名稱
# 多 App 模式：每個 App 的憑證仍是獨立 env 變數，YAML 只引用名稱
# FEISHU_OPS_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_OPS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_TRADE_APP_ID=cli_yyyyyyyyyyyyyyyy
# FEISHU_TRADE_APP_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 记忆功能开关（可选，默认关闭。零额外依赖，基于 sqlite3）
# ENABLE_MEMORY=true

# 群聊中是否只响应 @机器人 的消息（可选，默认 true）
# GROUP_AT_ONLY=true

# 群消息告警监听（可选，默认关闭）
# GROUP_ALERT_LISTEN_ENABLED=true

# === Webhook 告警接收配置 ===
# WEBHOOK_ENABLED=true
# WEBHOOK_PORT=8080
# WEBHOOK_HOST=127.0.0.1          # 127.0.0.1=仅本机, 0.0.0.0=全网卡, 192.168.x.x=内网
# WEBHOOK_TOKEN=change-me-secret

# === 主动告警推送 ===
# ALERT_NOTIFY_USER_ID=ou_xxxxxxxxxxxxxxxx
# ALERT_AUTO_ANALYZE_SEVERITY=high,critical
# ALERT_ANALYZE_TIMEOUT=300

# === 飞书群历史消息轮询（新增）===
# 指定要轮询的群 chat_id（逗号分隔），用于收取其他 Bot 的告警或群消息
# FEISHU_POLL_CHAT_IDS=oc_xxxxxxxxxx,oc_yyyyyyyyyy
# FEISHU_POLL_INTERVAL_SEC=10            # 轮询间隔（秒），默认 10

# === 微信 iLink（新增）===
# WEIXIN_BOT_TOKEN=                      # 可选；留空则启动时扫码获取
# WEIXIN_TOKEN_FILE=~/.kiro/weixin_token.json

# === 告警推送（改造）===
# 旧：ALERT_NOTIFY_USER_ID=ou_xxx
# 新：支持多目标，逗号分隔
ALERT_NOTIFY_TARGETS=feishu:ou_xxxxxxxx,weixin:wxid_xxxxxxxx@im.wechat

# === Dashboard Web Panel ===
# DASHBOARD_TOKEN=change-me-strong-secret
# === Prometheus 配置（Resource Dashboard 预留）===
# PROMETHEUS_URL=http://localhost:9090
